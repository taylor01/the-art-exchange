<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="mb-8 pt-4">
    <h1 class="text-3xl font-bold text-stone-900 mb-4">Venues</h1>
    
    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-6 gap-4 mb-6">
      <div class="bg-white p-4 rounded-lg border border-stone-200">
        <div class="text-2xl font-bold text-stone-900"><%= @total_venues %></div>
        <div class="text-sm text-stone-600">Total Venues</div>
      </div>
      <div class="bg-white p-4 rounded-lg border border-stone-200">
        <div class="text-2xl font-bold text-green-600"><%= @research_completed %></div>
        <div class="text-sm text-stone-600">Research Complete</div>
      </div>
      <div class="bg-white p-4 rounded-lg border border-stone-200">
        <div class="text-2xl font-bold text-yellow-600"><%= @research_pending %></div>
        <div class="text-sm text-stone-600">Research Pending</div>
      </div>
      <div class="bg-white p-4 rounded-lg border border-stone-200">
        <div class="text-2xl font-bold text-red-600"><%= @research_failed %></div>
        <div class="text-sm text-stone-600">Research Failed</div>
      </div>
      <div class="bg-white p-4 rounded-lg border border-stone-200">
        <div class="text-2xl font-bold text-green-600"><%= @claude_matched %></div>
        <div class="text-sm text-stone-600">Claude Matched</div>
      </div>
      <div class="bg-white p-4 rounded-lg border border-stone-200">
        <div class="text-2xl font-bold text-blue-600"><%= @claude_consulted %></div>
        <div class="text-sm text-stone-600">Claude Consulted</div>
      </div>
    </div>
    
    <!-- Search and Filter -->
    <div class="flex flex-col md:flex-row gap-4 mb-6">
      <%= form_with url: venues_path, method: :get, local: true, class: "flex flex-col md:flex-row gap-4 flex-1" do |form| %>
        <div class="flex-1">
          <%= form.text_field :search, 
                placeholder: "Search venues by name, city, or state...", 
                value: params[:search],
                class: "w-full px-4 py-3 text-sm border border-stone-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent" %>
        </div>
        <div class="w-48">
          <%= form.text_field :location, 
                placeholder: "Filter by location...", 
                value: params[:location],
                class: "w-full px-4 py-3 text-sm border border-stone-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent" %>
        </div>
        <div class="w-40">
          <%= form.select :research_status, 
                options_for_select([
                  ['All Research', ''],
                  ['Completed', 'completed'],
                  ['Pending', 'pending'],
                  ['Failed', 'failed']
                ], params[:research_status]),
                {},
                class: "w-full px-4 py-3 text-sm border border-stone-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent" %>
        </div>
        <div class="w-40">
          <%= form.select :claude_status, 
                options_for_select([
                  ['All Claude', ''],
                  ['Matched', 'matched'],
                  ['Unmatched', 'unmatched'],
                  ['Consulted', 'consulted']
                ], params[:claude_status]),
                {},
                class: "w-full px-4 py-3 text-sm border border-stone-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent" %>
        </div>
        <button type="submit" class="px-6 py-3 bg-red-600 text-white text-sm rounded-lg hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 transition-colors duration-200 whitespace-nowrap">
          Search
        </button>
      <% end %>
    </div>

    <!-- Results count -->
    <p class="text-sm text-stone-600 mb-4">
      Showing <%= @venues.count %> of <%= @venues.total_count %> venues
    </p>
  </div>

  <!-- Venues List -->
  <div class="bg-white rounded-lg shadow-sm border border-stone-200 overflow-hidden">
    <% if @venues.any? %>
      <div class="divide-y divide-stone-200">
        <% @venues.each do |venue| %>
          <div class="p-6 hover:bg-stone-50 transition-colors duration-200">
            <%= link_to venue_path(venue), class: "block" do %>
              <div class="flex items-center justify-between">
                <div class="flex-1">
                  <div class="flex items-center space-x-3 mb-2">
                    <h3 class="text-lg font-semibold text-stone-900">
                      <%= venue.name %>
                    </h3>
                    
                    <!-- Research Status Badge -->
                    <% case venue.research_status %>
                    <% when 'completed' %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                        🔍 Research Complete <%= venue.research_confidence %>%
                      </span>
                    <% when 'pending' %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                        ⏳ Research Pending
                      </span>
                    <% when 'in_progress' %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                        🔄 Research In Progress
                      </span>
                    <% when 'failed' %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                        ❌ Research Failed
                      </span>
                    <% end %>
                    
                    <!-- Claude Status Badge -->
                    <% if venue.claude_matched? %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
                        Claude Matched
                      </span>
                    <% elsif venue.claude_venue_consultations.any? %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">
                        Claude Consulted
                      </span>
                    <% end %>
                  </div>
                  
                  <div class="flex items-center space-x-4 text-sm text-stone-600 mb-2">
                    <span>📍 <%= [venue.city, venue.administrative_area].compact.join(', ') %></span>
                    <% if venue.venue_type.present? && venue.venue_type != 'other' %>
                      <span>🏛️ <%= venue.venue_type.humanize %></span>
                    <% end %>
                    <% if venue.capacity.present? %>
                      <span>👥 <%= number_with_delimiter(venue.capacity) %> capacity</span>
                    <% end %>
                  </div>
                  
                  <div class="flex items-center space-x-4 text-sm text-stone-600">
                    <span><%= pluralize(venue.shows.count, 'show') %></span>
                    <span><%= pluralize(venue.posters.count, 'poster') %></span>
                    <% if venue.claude_venue_consultations.any? %>
                      <span><%= pluralize(venue.claude_venue_consultations.count, 'Claude consultation') %></span>
                    <% end %>
                  </div>
                  
                  <!-- Historical Names -->
                  <% former_names = venue.venue_names.where.not(current: true).pluck(:name).uniq %>
                  <% if former_names.any? %>
                    <div class="mt-2">
                      <span class="text-xs font-medium text-stone-400">Formerly:</span>
                      <div class="text-xs text-stone-500 mt-0.5">
                        <%= former_names.join(', ') %>
                      </div>
                    </div>
                  <% end %>
                </div>
                
                <div class="flex-shrink-0 text-stone-400">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                  </svg>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
      
      <!-- Pagination -->
      <div class="px-6 py-4 border-t border-stone-200 bg-stone-50">
        <%= paginate @venues %>
      </div>
    <% else %>
      <div class="p-12 text-center">
        <div class="text-stone-400 mb-4">
          <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-2m-16 0h2m0 0V9a2 2 0 012-2h2m10 0V7a2 2 0 00-2-2H7a2 2 0 00-2 2v2m14 0V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16"></path>
          </svg>
        </div>
        <h3 class="text-lg font-medium text-stone-900 mb-2">No venues found</h3>
        <p class="text-stone-600">Try adjusting your search or filter criteria.</p>
      </div>
    <% end %>
  </div>
</div>